# ═══════════════════════════════════════════════════════════════════════════════
# TranscribeFlow Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to backend/.env and fill in your values
# Priority: config.json (UI settings) > environment variables > .env > code defaults

# ═══════════════════════════════════════════════════════════════════════════════
# PATHS
# ═══════════════════════════════════════════════════════════════════════════════
# Base directory for all transcription files
# Default: ~/Transcriptions
# TRANSCRIBEFLOW_BASE_PATH=~/Transcriptions

# ═══════════════════════════════════════════════════════════════════════════════
# TRANSCRIPTION SETTINGS
# ═══════════════════════════════════════════════════════════════════════════════
# Default transcription engine
# Options: mlx-whisper | assemblyai | deepgram | elevenlabs | yandex
# - mlx-whisper: Local, Apple Silicon optimized (recommended for Mac)
# - assemblyai: AssemblyAI cloud transcription
# - deepgram: Deepgram cloud transcription
# - elevenlabs: ElevenLabs Scribe transcription
# - yandex: Yandex SpeechKit (optimized for Russian)
TRANSCRIBEFLOW_DEFAULT_ENGINE=mlx-whisper

# Default Whisper model (for mlx-whisper engine)
# Options: tiny | base | small | medium | large-v2 | large-v3 | large-v3-turbo
# Recommendations:
# - M1 Pro / M2 Pro+ / M3 Pro+ / M4 Pro+ → large-v3 (best quality)
# - MacBook Air / base M1/M2/M3/M4 → large-v3-turbo (faster, slightly less accurate)
# - Older/weaker hardware → medium or small
TRANSCRIBEFLOW_DEFAULT_MODEL=large-v3

# ═══════════════════════════════════════════════════════════════════════════════
# SPEAKER DIARIZATION (who said what)
# ═══════════════════════════════════════════════════════════════════════════════
# Diarization method
# Options: none | fast | accurate
# - none: Disabled (no speaker identification)
# - fast: GPU-accelerated, recommended for M1 Pro+
# - accurate: Slower but higher quality speaker separation
TRANSCRIBEFLOW_DIARIZATION_METHOD=fast

# Compute device for diarization
# Options: auto | mps | cpu
# - auto: Automatically select best available device
# - mps: Apple Silicon GPU (faster, recommended for M1 Pro+)
# - cpu: CPU only (use if GPU causes freezing/overheating)
TRANSCRIBEFLOW_COMPUTE_DEVICE=auto

# HuggingFace token for Pyannote diarization models
# Required for speaker diarization to work
# How to get:
# 1. Create account: https://huggingface.co
# 2. Get token: https://huggingface.co/settings/tokens
# 3. Accept license: https://huggingface.co/pyannote/speaker-diarization-3.1
# Format: hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TRANSCRIBEFLOW_HF_TOKEN=

# Expected number of speakers in recordings
TRANSCRIBEFLOW_MIN_SPEAKERS=2
TRANSCRIBEFLOW_MAX_SPEAKERS=6

# ═══════════════════════════════════════════════════════════════════════════════
# WHISPER QUALITY SETTINGS (Anti-Hallucination)
# ═══════════════════════════════════════════════════════════════════════════════
# These help prevent fake text like "Субтитры сделал DimaTorzok"
# that Whisper generates during silence or low-quality audio.

# Skip segments where probability of "no speech" exceeds this threshold
# Range: 0.0-1.0 | Higher = more aggressive filtering | Default: 0.6
TRANSCRIBEFLOW_WHISPER_NO_SPEECH_THRESHOLD=0.6

# Skip segments with average log probability below this value
# Range: negative float | More negative = stricter | Default: -1.0
TRANSCRIBEFLOW_WHISPER_LOGPROB_THRESHOLD=-1.0

# Skip segments with high compression ratio (repetitive/garbled text)
# Range: positive float | Lower = stricter | Default: 2.4
TRANSCRIBEFLOW_WHISPER_COMPRESSION_RATIO_THRESHOLD=2.4

# Skip silence gaps longer than N seconds (prevents hallucinations during silence)
# Set empty to disable | Default: 2.0
TRANSCRIBEFLOW_WHISPER_HALLUCINATION_SILENCE_THRESHOLD=2.0

# Use previous transcribed text as context for next segment
# Options: true | false | Default: true
TRANSCRIBEFLOW_WHISPER_CONDITION_ON_PREVIOUS_TEXT=true

# Optional context prompt to guide transcription
# Example: "Это рабочий митинг команды разработки"
# Leave empty for no prompt
TRANSCRIBEFLOW_WHISPER_INITIAL_PROMPT=

# ═══════════════════════════════════════════════════════════════════════════════
# CLOUD ASR PROVIDERS (alternative to local Whisper)
# ═══════════════════════════════════════════════════════════════════════════════
# All providers are fully implemented and ready to use

# AssemblyAI - High accuracy, good for English
# Get key: https://www.assemblyai.com/dashboard/signup
# Format: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TRANSCRIBEFLOW_ASSEMBLYAI_API_KEY=

# Deepgram - Fast and accurate, real-time capable
# Get key: https://console.deepgram.com/signup
# Format: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TRANSCRIBEFLOW_DEEPGRAM_API_KEY=

# ElevenLabs Scribe - High quality transcription
# Get key: https://elevenlabs.io (Profile → API Keys)
# Format: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TRANSCRIBEFLOW_ELEVENLABS_API_KEY=

# Yandex SpeechKit - Excellent for Russian language
# Get key: https://cloud.yandex.ru/services/speechkit
# Format: IAM token or API key from Yandex Cloud console
TRANSCRIBEFLOW_YANDEX_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# LLM PROVIDERS (for AI post-processing and insights)
# ═══════════════════════════════════════════════════════════════════════════════
# Default LLM provider for all AI features
# Options: gemini | openrouter
TRANSCRIBEFLOW_DEFAULT_LLM_PROVIDER=gemini

# Google Gemini API - Fast, cheap, free tier available
# Get key: https://aistudio.google.com/app/apikey
# Format: AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TRANSCRIBEFLOW_GEMINI_API_KEY=

# OpenRouter API - Access to many models (GPT-4, Claude, DeepSeek, etc.)
# Get key: https://openrouter.ai/keys
# Format: sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TRANSCRIBEFLOW_OPENROUTER_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# POST-PROCESSING SETTINGS (Level 1 - Transcript Cleanup)
# ═══════════════════════════════════════════════════════════════════════════════
# Cleans ASR errors, merges fragments, identifies speakers by name

# Provider for post-processing
# Options: gemini | openrouter
TRANSCRIBEFLOW_POSTPROCESSING_PROVIDER=gemini

# Model for post-processing
# ┌───────────────────────────────────────────────────────────────────────────────┐
# │ GEMINI MODELS (provider: gemini) — direct Google API                          │
# ├───────────────────────────────────────────────────────────────────────────────┤
# │ gemini-3.1-pro-preview  │ Best quality, 1M ctx            │ $2.00/1M in       │
# │ gemini-3.5-flash        │ Fast + quality, 1M ctx ⭐        │ $1.50/1M in       │
# │ gemini-3-flash-preview  │ Fast preview, 1M ctx            │ $0.50/1M in       │
# │ gemini-3.1-flash-lite   │ Cheapest 3.x, 1M ctx            │ $0.25/1M in       │
# │ gemini-2.5-pro          │ Stable Pro, 1M ctx              │ $1.25/1M in       │
# │ gemini-2.5-flash        │ Fast, good quality, 1M ctx      │ $0.30/1M in       │
# │ gemini-2.5-flash-lite   │ Fastest 2.5, 1M ctx             │ $0.10/1M in       │
# ├───────────────────────────────────────────────────────────────────────────────┤
# │ OPENROUTER MODELS (provider: openrouter) — multi-provider access              │
# ├───────────────────────────────────────────────────────────────────────────────┤
# │ 🔥 LARGE CONTEXT (1M+ tokens):                                                │
# │ x-ai/grok-4.1-fast             │ 2M context! Fast      │ $0.20/1M in           │
# │ google/gemini-3.1-pro-preview  │ 1M ctx via OR         │ $2.00/1M in           │
# │ google/gemini-3.5-flash        │ 1M ctx via OR ⭐       │ $1.50/1M in           │
# │ google/gemini-3-flash-preview  │ 1M ctx via OR         │ $0.50/1M in           │
# │ google/gemini-3.1-flash-lite   │ 1M ctx via OR         │ $0.25/1M in           │
# │ google/gemini-2.5-pro          │ 1M ctx via OR         │ $1.25/1M in           │
# │ google/gemini-2.5-pro-preview  │ 1M ctx via OR         │ $1.25/1M in           │
# │ google/gemini-2.5-flash        │ 1M ctx via OR         │ $0.30/1M in           │
# │ google/gemini-2.5-flash-lite   │ 1M ctx via OR         │ $0.10/1M in           │
# │ anthropic/claude-sonnet-4      │ 1M ctx, best writing  │ $3.00/1M in           │
# │ openai/gpt-4.1-mini            │ 1M ctx, fast          │ $0.40/1M in           │
# │ meta-llama/llama-4-maverick    │ 1M ctx, very cheap    │ $0.15/1M in           │
# ├───────────────────────────────────────────────────────────────────────────────┤
# │ 🧠 REASONING MODELS:                                                          │
# │ deepseek/deepseek-r1          │ Deep reasoning        │ $0.70/1M in           │
# └───────────────────────────────────────────────────────────────────────────────┘
TRANSCRIBEFLOW_POSTPROCESSING_MODEL=gemini-3-flash-preview

# Default template for post-processing (leave empty to always ask in UI)
# Options: it-meeting | sales-call | interview
TRANSCRIBEFLOW_POSTPROCESSING_DEFAULT_TEMPLATE=

# ═══════════════════════════════════════════════════════════════════════════════
# AI INSIGHTS SETTINGS (Level 2 - Structured Analysis)
# ═══════════════════════════════════════════════════════════════════════════════
# Extracts action items, decisions, blockers, generates mindmaps

# Provider for insights
# Options: gemini | openrouter
TRANSCRIBEFLOW_INSIGHTS_PROVIDER=gemini

# Model for insights extraction (same options as post-processing above)
TRANSCRIBEFLOW_INSIGHTS_MODEL=gemini-3-flash-preview 

# Default template for insights (leave empty to always ask in UI)
# Options: it-meeting | sales-call | business-meeting | interview | retrospective |
#          brainstorm | podcast | design-call | pre-grooming | grooming | feature-discussion
TRANSCRIBEFLOW_INSIGHTS_DEFAULT_TEMPLATE=

# ═══════════════════════════════════════════════════════════════════════════════
# SERVER SETTINGS
# ═══════════════════════════════════════════════════════════════════════════════
# Backend host (0.0.0.0 for LAN access, 127.0.0.1 for localhost only)
TRANSCRIBEFLOW_BACKEND_HOST=0.0.0.0
TRANSCRIBEFLOW_BACKEND_PORT=8000
